# Copy this file to .env on your own computer. Never upload .env to GitHub.
BYBIT_ENVIRONMENT=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Set true only after creating a Bybit Demo API key with derivatives trade permission.
# Orders are restricted in code to Bybit Demo USDT perpetuals; live trading stays hard-disabled.
BYBIT_DEMO_AUTO_EXECUTION=true
BYBIT_DEMO_ORDER_NOTIONAL_USDT=3
BYBIT_DEMO_TOTAL_BUDGET_USDT=250

DEFAULT_EXCHANGE=Bybit Demo
DEFAULT_SYMBOL=BTC/USDT:USDT
ACTIVE_PAIRS=
FUTURES_LEVERAGE=7
TARGET_RR=5.0
SCAN_TIMEFRAME=15m
SCAN_INTERVAL_SECONDS=60
